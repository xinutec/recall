# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
# No trailing slash: `.venv` is a SYMLINK into the store now (built by
# `nix build .#dev-env --out-link .venv`), and `.venv/` matches only directories
# — so the trailing slash left the symlink showing as an untracked file.
.venv
*.egg-info/
dist/
build/

# nix
result
result-*

# angular frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/

# recall runtime data — NEVER commit audio or transcripts
data/
audio/
logs/
*.wav
*.flac
*.opus
*.sqlite
*.sqlite3
*.db

# local secrets (e.g. HuggingFace token) — never commit
.env

# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
# No trailing slash: `.venv` is a symlink into the store
# (`nix build .#dev-env --out-link .venv`), and `.venv/` matches only directories.
.venv
*.egg-info/
dist/
build/

# nix
result
result-*

# rust
target/

# angular frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/

# recall runtime data — never commit audio or transcripts
data/
audio/
logs/
*.wav
*.flac
*.opus
# ...except the test clips, so checks run on a fresh clone (#1433; see
# tests/fixtures/speech/README.md). Named one by one: a pattern would adopt
# whatever lands in that directory next, including household audio.
!tests/fixtures/speech/public-domain-en.flac
# Synthetic speech from scripts/gen-speech-fixture.sh (macOS `say`, invented
# lines), the gate's only Dutch. Committed because `say` does not run on CI's
# Ubuntu; the owner waived the no-audio rule for them on 2026-09-09.
!tests/fixtures/speech/dialogue-en.flac
!tests/fixtures/speech/dialogue-nl.flac
*.sqlite
*.sqlite3
*.db

# local secrets (e.g. HuggingFace token) — never commit
.env

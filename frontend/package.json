    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@xinutec/ui-scaffold": "github:xinutec/ui-harness#668377e632d9ef3a1f7d788a35124f4e8fd6b770&path:/scaffold",
    "material-icons": "^1.13.14",

    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",

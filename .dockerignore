# The whole build context goes to the daemon, COPY or not. Locally that includes
# .env and data/ (recordings and transcripts); CI's clean checkout has neither.

# Secrets and runtime data.
.env
data/
audio/
logs/
work/
*.wav
*.flac
*.opus
*.sqlite
*.sqlite3
*.db

# Installed trees and build output. Otherwise `COPY frontend/ ./` would put the
# local node_modules, pnpm's symlinks that do not survive the copy, over the
# image's own.
.venv/
frontend/node_modules/
frontend/dist/
frontend/.angular/
__pycache__/
*.egg-info/
result
result-*

# Caches and platform sources the image has no use for.
.mypy_cache/
.pytest_cache/
.ruff_cache/
android/
ios/
.git/
